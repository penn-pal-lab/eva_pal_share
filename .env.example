# Eva environment configuration — EXAMPLE
#
# Copy to `.env` and fill in your own values, then load it before running Eva:
#     cp .env.example .env
#     set -a; source .env; set +a      # exports every line for this shell
#
# Every variable below has a safe default baked into the code, so you only need
# to set the ones that differ from your setup. `.env` is gitignored — never
# commit real serials, IPs, URLs, or secrets.

# ─────────────────────────── Robot / network (parameters.py) ───────────────────────────
# 172.16.0.x are the standard DROID NUC/robot IPs; change only if your wiring differs.
export NUC_IP=172.16.0.4
export ROBOT_IP=172.16.0.2
export LAPTOP_IP=127.0.0.1
# sudo password used by eva/robot launch scripts. Keep it out of source control.
export EVA_SUDO_PASSWORD=

# ─────────────────────────── MolmoAct2 policy server (parameters.py) ───────────────────────────
# LAN host server (allenai/molmoact2: examples/droid/host_server_droid.py).
export POLICY_SERVER_IP=127.0.0.1
export POLICY_SERVER_PORT=8101
# The `ngrok` preset's URL (used by `run_molmoact2.py --server ngrok`).
export MOLMOACT2_NGROK_URL=https://YOUR-TUNNEL.ngrok-free.dev/act

# ─────────────────────────── ZED cameras (parameters.py) ───────────────────────────
# Serial numbers — find them with ZED_Explorer or
# `zed.get_camera_information().serial_number`.
export HAND_CAMERA_ID=00000000        # ZED Mini (wrist)
export VARIED_CAMERA_1_ID=11111111    # ZED 2 (shoulder)
export VARIED_CAMERA_2_ID=22222222    # ZED 2 (side)

# ─────────────────────────── Data / training cluster ───────────────────────────
# Local human-demo data directory (eva/utils/human_traj_adapter.py, human_pi0.py).
export EVA_HUMAN_DATA=$HOME/eva_data/human_data
# scp target for shipping collected data to a training cluster.
export EVA_CLUSTER_DEST=user@cluster.example.com:/path/to/data/   # scripts/process_trajectory.py
export EVA_CLUSTER_HOST=user@cluster.example.com                  # scripts/send_data.py

# ─────────────────────────── Optional integrations ───────────────────────────
# Ably remote timer (eva/remote_timer.py). Leave empty to disable the timer.
export ABLY_API_KEY=
# DINO-X / Grounding-DINO detectors (eva/detectors/). Only needed if you use them.
export DDS_CLOUDAPI_TOKEN=
export GDINO_WEIGHTS_DIR=

# ─────────────────────────── Editable installs (pixi run install-local) ───────────────────────────
# Override only if these repos are not under $HOME.
export OPENPI_CLIENT_PATH=$HOME/openpi-main/packages/openpi-client
export OCULUS_READER_PATH=$HOME/oculus_reader
export DROID_PATH=$HOME/droid
